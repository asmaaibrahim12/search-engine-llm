# Claude API key — get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Postgres connection string. On Railway this is injected automatically when
# you link a Postgres plugin to the web service.
DATABASE_URL=postgres://user:pass@localhost:5432/outdoors

# Optional: path to the outdoors posts CSV when running the indexer locally.
OUTDOORS_CSV_PATH=data/outdoors/posts.csv
