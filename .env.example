# Claude API key — get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Postgres connection string. On Railway this is injected automatically when
# you link a Postgres plugin to the web service.
DATABASE_URL=postgres://user:pass@localhost:5432/outdoors

# Optional: path to the outdoors posts CSV when running the indexer locally.
OUTDOORS_CSV_PATH=data/outdoors/posts.csv

# Production-only: set to 1 on HTTPS deploys so the session cookie gets
# the Secure flag and is never sent over plaintext. Leave unset for local
# HTTP dev or the browser will drop the cookie.
COOKIE_SECURE=

# Shared secret that protects /admin/* endpoints. Unset = endpoints 503,
# which is the safe default for public deploys.
ADMIN_TOKEN=

# How often (seconds) to refresh the result_ctr materialized view from
# the background loop. Default 300s; set to 0 to disable and refresh
# manually via POST /admin/refresh_ctr.
RESULT_CTR_REFRESH_SEC=
